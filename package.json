{
  "name": "ami-to-s3",
  "version": "1.0.0",
  "description": "CLI to copy a saved AWS AMI to S3, optionally gzip-compress it, and remove the uncompressed original.",
  "license": "MIT",
  "bin": {
    "ami-to-s3": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1155.0",
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/client-sts": "^3.1155.0",
    "@aws-sdk/credential-providers": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "@aws-sdk/types": "^3.975.0",
    "commander": "^12",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2"
  }
}
